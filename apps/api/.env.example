# API Service (apps/api) — Environment Variables (PROMPT §13)
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/recallai

# JWT (use RS256 key pair — generate with: ssh-keygen -t rsa -b 4096 -m PEM -f jwtRS256.key)
JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----...
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----...
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_REGION=us-east-1
AWS_S3_UPLOADS_BUCKET=recallai-uploads-us
AWS_S3_EXPORTS_BUCKET=recallai-exports
AWS_S3_MEDIA_BUCKET=recallai-media-us

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# Email
RESEND_API_KEY=
FROM_EMAIL=hello@recallai.com

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
