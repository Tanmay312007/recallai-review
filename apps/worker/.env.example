# Worker Service (apps/worker) — Environment Variables (PROMPT §13)
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/recallai

# Redis
REDIS_URL=redis://localhost:6379

# AWS
AWS_REGION=us-east-1
AWS_S3_UPLOADS_BUCKET=recallai-uploads-us

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# YouTube
YOUTUBE_API_KEY=

# Primary AI provider (openai | anthropic)
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=anthropic

# Cost controls (PROMPT §13)
AI_DAILY_COST_LIMIT_USD=200
AI_PER_USER_MONTHLY_COST_LIMIT_USD=2.00
