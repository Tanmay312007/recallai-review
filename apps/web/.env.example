# Web App (Next.js) — Client-Facing Environment Variables
# Only NEXT_PUBLIC_* variables are exposed to the browser (PROMPT §15).
# All other config comes from the API service.

NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=
