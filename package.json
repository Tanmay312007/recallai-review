{
  "name": "lumora",
  "version": "0.1.0-alpha",
  "private": true,
  "description": "Lumora — The Intelligent Workspace for Knowledge. Monorepo root.",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md,yml,yaml}\"",
    "clean": "turbo run clean && rimraf node_modules",
    "db:migrate": "pnpm --filter @lumora/api exec prisma migrate dev",
    "db:generate": "pnpm --filter @lumora/api exec prisma generate",
    "db:studio": "pnpm --filter @lumora/api exec prisma studio"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "turbo": "^2.2.3",
    "typescript": "^5.6.2"
  }
}
