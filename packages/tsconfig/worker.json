{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "RecallAI — Worker (apps/worker)",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "lib": ["ES2022"],

    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false,
    "verbatimModuleSyntax": false,

    "isolatedModules": false,
    "sourceMap": true,
    "incremental": true,
    "removeComments": true
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts"]
}
